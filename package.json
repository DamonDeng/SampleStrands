{
  "name": "samplestrands",
  "version": "1.0.0",
  "description": "SampleStrands App built with Electron + Next.js + TypeScript",
  "main": "dist/main.js",
  "scripts": {
    "start:backend": "cd backend && conda run -n for_sample_strands python main.py",
    "start:backend:secure": "./scripts/start-secure-backend.sh",
    "dev:frontend": "concurrently \"npm run dev:next\" \"node scripts/wait-for-backend.js http://localhost:3867/health && npm run dev:electron:frontend-only\"",
    "dev:frontend:secure": "concurrently \"npm run dev:next\" \"node scripts/wait-for-backend.js https://localhost:3867/health && cross-env SECURITY_MODE=true npm run dev:electron:frontend-only\"",
    "dev": "concurrently \"npm run start:backend\" \"npm run dev:frontend\"",
    "secure-dev": "concurrently \"npm run start:backend:secure\" \"npm run dev:frontend:secure\"",
    "dev:next": "next dev",
    "dev:electron": "wait-on http://localhost:3000 && electron .",
    "dev:electron:frontend-only": "cross-env BACKEND_EXTERNAL=true wait-on http://localhost:3000 && electron .",
    "setup:dev-security": "node scripts/setup-dev-security.js",
    "build": "npm run build:next && npm run build:backend && npm run build:electron",
    "build:next": "next build",
    "build:backend": "cd backend && conda run -n for_sample_strands pyinstaller samplestrands-backend.spec --clean --noconfirm",
    "build:electron": "tsc -p electron",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "clean": "rimraf dist out .next backend/dist backend/build",
    "clean:backend": "cd backend && rimraf dist build *.spec",
    "type-check": "tsc --noEmit",
    "lint": "next lint"
  },
  "keywords": [
    "electron",
    "nextjs",
    "typescript",
    "react",
    "desktop",
    "ai",
    "chat"
  ],
  "author": "DamonDeng <dengmingxuan@hotmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@types/highlight.js": "9.12.4",
    "@types/katex": "0.16.7",
    "@types/lowlight": "0.0.7",
    "@types/node": "20.19.1",
    "@types/node-forge": "1.3.11",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "concurrently": "8.2.2",
    "cross-env": "7.0.3",
    "electron": "28.3.3",
    "electron-builder": "24.13.3",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.30",
    "rimraf": "5.0.10",
    "typescript": "5.8.3",
    "wait-on": "7.2.0"
  },
  "dependencies": {
    "highlight.js": "11.11.1",
    "i18next": "25.3.0",
    "i18next-browser-languagedetector": "8.2.0",
    "katex": "0.16.22",
    "lowlight": "3.3.0",
    "next": "14.2.30",
    "node-forge": "1.3.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "15.5.3",
    "react-icons": "5.5.0",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "rehype-katex": "7.0.1",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0"
  },
  "build": {
    "appId": "com.damondeng.samplestrands",
    "productName": "SampleStrands",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "out/**/*",
      "!out/mac*/**/*",
      "!out/*.dmg*",
      "!out/builder-*"
    ],
    "asarUnpack": [
      "node_modules/node-forge/**/*"
    ],
    "extraResources": [
      {
        "from": "out",
        "to": "app",
        "filter": [
          "**/*",
          "!mac*/**/*",
          "!*.dmg*",
          "!builder-*"
        ]
      },
      {
        "from": "backend/dist/samplestrands-backend",
        "to": "backend/samplestrands-backend"
      },
      {
        "from": "backend/config",
        "to": "backend/config"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
