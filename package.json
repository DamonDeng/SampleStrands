{
  "name": "samplestrands",
  "version": "1.0.0",
  "description": "SampleStrands App built with Electron + Next.js + TypeScript",
  "main": "dist/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:next\" \"npm run dev:electron\"",
    "dev:next": "next dev",
    "dev:electron": "wait-on http://localhost:3000 && electron .",
    "build": "npm run build:next && npm run build:backend && npm run build:electron",
    "build:next": "next build",
    "build:backend": "cd backend && conda run -n for_sample_strands pyinstaller samplestrands-backend.spec --clean --noconfirm",
    "build:electron": "tsc -p electron",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "clean": "rimraf dist out .next backend/dist backend/build",
    "clean:backend": "cd backend && rimraf dist build *.spec",
    "type-check": "tsc --noEmit",
    "lint": "next lint"
  },
  "keywords": [
    "electron",
    "nextjs",
    "typescript",
    "react",
    "desktop",
    "ai",
    "chat"
  ],
  "author": "DamonDeng <dengmingxuan@hotmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@types/highlight.js": "^9.12.4",
    "@types/katex": "^0.16.7",
    "@types/lowlight": "^0.0.7",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.8.0",
    "eslint": "^8.55.0",
    "eslint-config-next": "^14.0.4",
    "rimraf": "^5.0.5",
    "typescript": "^5.3.3",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "katex": "^0.16.22",
    "lowlight": "^3.3.0",
    "next": "^14.0.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "build": {
    "appId": "com.damondeng.samplestrands",
    "productName": "SampleStrands",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "out/**/*",
      "!out/mac*/**/*",
      "!out/*.dmg*",
      "!out/builder-*",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "out",
        "to": "app",
        "filter": [
          "**/*",
          "!mac*/**/*",
          "!*.dmg*",
          "!builder-*"
        ]
      },
      {
        "from": "backend/dist/samplestrands-backend",
        "to": "backend/samplestrands-backend"
      },
      {
        "from": "backend/config",
        "to": "backend/config"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
